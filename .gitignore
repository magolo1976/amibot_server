# ------------------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
[Mm]in[Ss]ize[Rr]el/
[Rr]el[Ww]ith[Dd]eb[Ii]nfo/
x64/
x86/
build/
**/build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.dir/
*.tlog/
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.a
*.exe
*.dll
*.so
*.so.*
*.dylib

